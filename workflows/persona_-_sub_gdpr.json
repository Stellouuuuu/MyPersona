      "name": "Get All Users"
    },
    {
      "parameters": {
        "jsCode": "\nfunction isExpired(isoDate) {\n  if (!isoDate) return true;\n  return new Date(isoDate) < new Date();\n}\n\nconst trigger = $('When Executed by Another Workflow').first().json;\nconst action = trigger.action;\nconst token = trigger.sessionToken || '';\nconst rows = $input.all().map(i => i.json);\n\nlet user = null;\nif (trigger.gdprTokenVerified === true && trigger.userId) {\n  user = rows.find(r => r.username === trigger.userId || String(r.id) === String(trigger.userId));\n} else if (token) {\n  user = rows.find(r => r.session_token === token);\n  if (user && action !== 'delete' && isExpired(user.session_expires_at)) {\n    return { json: { success: false, error: 'Session expiree.' } };\n  }\n}\n\nif (!user) {\n  return { json: { success: false, error: 'Utilisateur introuvable.' } };\n}\n\nif (action === 'export') {\n  return {\n    json: {\n      success: true,\n      username: user.username,\n      data: {\n        username: user.username,\n        email: user.email,\n        interests: user.interests,\n        schedule_time: user.schedule_time,\n        active: user.active,\n        blocked_topics: user.blocked_topics || '',\n        blocked_sources: user.blocked_sources || '',\n        preferences: user.preferences || '',\n        created_at: user.created_at,\n        gdpr_consent_at: user.gdpr_consent_at\n      }\n    }\n  };\n}\n\nif (action === 'unsubscribe') {\n  return {\n    json: {\n      _update: true,\n      username: user.username,\n      active: false,\n      username: user.username,\n      success: true\n    }\n  };\n}\n\nif (action === 'delete') {\n  return {\n    json: {\n      _delete: true,\n      username: user.username,\n      username: user.username,\n      success: true\n    }\n  };\n}\n\nreturn { json: { success: false, error: 'Action RGPD inconnue.' } };\n"
      },
