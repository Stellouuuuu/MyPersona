# =============================================================================
# Persona — Fichiers à NE PAS envoyer (git / remote / livrable)
# =============================================================================
# Livrable attendu : README, docker-compose, .env.example, workflows/*.json
# (workflows anonymisés — sans credentials N8N)
# =============================================================================

# --- Documentation interne (présentation, guides, explications) ---
docs/

# --- Scripts dev / migration / patch / tests locaux ---
scripts/

# --- Secrets & configuration locale ---
.env
.env.local
.env.*.local
!.env.example
credentials.json
secrets/
*.pem
*.key

# --- Données N8N locales (SQLite, logs, exécutions, cache) ---
n8n_data/
*.sqlite
*.sqlite3
*.db

# --- Exports N8N bruts (peuvent contenir des credentials) ---
exports/
backups/
*.backup.json

# --- Logs ---
*.log
logs/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
.envrc

# --- Node (si plugins N8N locaux) ---
node_modules/

# --- Docker (volumes / overrides locaux) ---
docker-compose.override.yml
.docker/

# --- IDE / éditeur ---
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Fichiers temporaires ---
tmp/
temp/
*.tmp
*.bak
